# Akıllı Yaya Güvenliği Sistemi - Environment Ayarları
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin

# ==================== Backend Ayarları ====================
# API sunucu portu
BACKEND_PORT=8001

# Geliştirme modu (True ise hot reload aktif)
DEBUG=True

# ==================== Model Ayarları ====================
# Yaya tespit modeli yolu (boş bırakılırsa otomatik aranır)
# MODEL_PATH=runs/train/ai2_balanced_v1/weights/best.pt

# Tespit güven eşiği (0-1 arası)
CONFIDENCE_THRESHOLD=0.3

# IoU eşiği (0-1 arası)
IOU_THRESHOLD=0.45

# ==================== Yaya Geçidi Ayarları ====================
# Varsayılan yol uzunluğu (metre)
ROAD_LENGTH_M=10.0

# Minimum yeşil ışık süresi (saniye)
MIN_GREEN_TIME=10.0

# ==================== Kategori Ek Süreleri (saniye) ====================
EXTRA_TIME_ELDERLY=5
EXTRA_TIME_CHILD=4
EXTRA_TIME_DISABLED=7
EXTRA_TIME_ADULT=0

# ==================== Frontend Ayarları ====================
# (Frontend için .env dosyasını frontend/ klasöründe oluşturun)
# VITE_BACKEND_HOST=localhost:8001
